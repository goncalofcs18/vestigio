{
  "expo": {
    "name": "Vestígio",
    "slug": "vestigio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vestigio",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.goncalosousa.vestigio",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A localização é usada para mostrar a distância aos lugares e confirmar os check-ins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E4BA8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pt.goncalosousa.vestigio"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA"
        }
      ],
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A localização é usada para mostrar a distância aos lugares e confirmar os check-ins."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}